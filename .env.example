# ---------------------------------------------------------------------------
# BOE Costing Portal -- configuration overview
#
# There are two config files, one per service. Neither is committed.
#
#   backend/.env         copy from backend/.env.example
#   frontend/.env.local  copy from frontend/.env.example
#
# Both point at the SAME Supabase project. The backend writes parsed BOEs to
# it; the frontend reads them back.
# ---------------------------------------------------------------------------

# --- backend/.env ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_KEY=<service-role key preferred; anon works if storage policies allow>
# ALLOWED_ORIGINS=*

# --- frontend/.env.local ---
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key -- this one reaches the browser>
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
