# Parser service configuration.
# Copy to backend/.env and fill in. That file is gitignored.
#
# Same Supabase project the frontend uses. Prefer the service_role key here:
# this runs server-side, never in a browser, and Storage uploads need it.
# The anon key also works if your storage policies allow it.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service-role-or-anon-key>

# Browsers allowed to call this service. Comma separated, or * for any.
ALLOWED_ORIGINS=*
