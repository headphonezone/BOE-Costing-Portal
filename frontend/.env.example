# Portal configuration. Copy to frontend/.env.local and fill in.
# That file is gitignored.

# Supabase project. Must be the SAME project backend/.env points at.
# Use the anon key here -- anything in this file reaches the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# The parser service.
#
# LEAVE THIS UNSET IN PRODUCTION. The parser ships inside the same Vercel
# deployment (frontend/api/) and the portal calls /api on its own origin,
# which is the default.
#
# Set it only for local development, where the parser runs as its own process
# on port 8000. Needed for PDF upload and the two Excel downloads; the records
# list, manual entry, costing and simulations all work without it.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Server-only key, used to sign links to stored BOE PDFs. NOT prefixed with
# NEXT_PUBLIC_, and it must never be -- that prefix compiles a value into the
# JavaScript sent to browsers.
#
# Setting this is what allows the document bucket to refuse the anon key,
# which otherwise lets anyone with the site URL list and download every Bill
# of Entry. Falls back to the anon key when unset, so the portal keeps working
# either way; lock the bucket down only once this is set.
SUPABASE_SERVICE_KEY=<service-role key from Supabase -> Settings -> API>
