# Portal configuration. Copy to frontend/.env.local and fill in.
# That file is gitignored.

# Supabase project. Must be the SAME project backend/.env points at.
# Use the anon key here -- anything in this file reaches the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# The parser service in ../backend. Needed for PDF upload only -- manual
# entry, the records list, costing and simulations all work without it.
# Point at any host running that code: localhost, Cloud Run, anywhere.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
