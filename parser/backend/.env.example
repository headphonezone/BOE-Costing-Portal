# Parser service configuration.
# Copy to frontend/api/.env and fill in. That file is gitignored.
#
# On Vercel these are set as project environment variables instead, and no
# .env file exists -- load_dotenv simply finds nothing and moves on.
#
# Same Supabase project the frontend uses. Prefer the service_role key here:
# this runs server-side, never in a browser, and Storage uploads need it.
# The anon key also works if your storage policies allow it.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service-role-or-anon-key>

# Browsers allowed to call this service. Irrelevant on Vercel, where the
# portal and the parser share an origin. Matters only if you host the
# container separately. Comma separated, or * for any.
ALLOWED_ORIGINS=*

# Shared secret for the endpoints the portal never calls -- delete a BOE,
# patch a variable field, upload a supporting document, and the two raw
# read endpoints. Without it those return 503 rather than running: they were
# reachable by anyone who knew the URL, and DELETE removes a record, its
# items, licences, history and the PDFs in Storage.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PARSER_ADMIN_TOKEN=
